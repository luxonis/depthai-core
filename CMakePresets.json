{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "VCPKG_INSTALL_OPTIONS": "--clean-buildtrees-after-build;--clean-packages-after-build"
      }
    },
    {
      "name": "minimal",
      "displayName": "Minimal host library build",
      "description": "Build depthai-core with optional host features, firmware downloads, and resource embedding disabled.",
      "binaryDir": "${sourceDir}/build-minimal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DEPTHAI_OPENCV_SUPPORT": "OFF",
        "DEPTHAI_XTENSOR_SUPPORT": "OFF",
        "DEPTHAI_DYNAMIC_CALIBRATION_SUPPORT": "OFF",
        "DEPTHAI_ENABLE_LIBUSB": "OFF",
        "DEPTHAI_ENABLE_APRIL_TAG": "OFF",
        "DEPTHAI_ENABLE_PROTOBUF": "OFF",
        "DEPTHAI_ENABLE_CURL": "OFF",
        "DEPTHAI_ENABLE_MP4V2": "OFF",
        "DEPTHAI_ENABLE_BACKWARD": "OFF",
        "DEPTHAI_ENABLE_DEVICE_FW": "OFF",
        "DEPTHAI_ENABLE_DEVICE_BOOTLOADER_FW": "OFF",
        "DEPTHAI_ENABLE_DEVICE_RVC4_FW": "OFF",
        "DEPTHAI_BINARIES_RESOURCE_COMPILE": "OFF",
        "DEPTHAI_GENERATE_HOUSING_COORDS": "OFF",
        "VCPKG_INSTALL_OPTIONS": "--clean-buildtrees-after-build;--clean-packages-after-build"
      }
    },
    {
      "name": "device-manager",
      "displayName": "Device manager library build",
      "description": "Build depthai::device-manager, the bootloader/XLink-only library with the embedded bootloader firmware and no pipeline.",
      "binaryDir": "${sourceDir}/build-device-manager",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DEPTHAI_OPENCV_SUPPORT": "OFF",
        "DEPTHAI_XTENSOR_SUPPORT": "OFF",
        "DEPTHAI_DYNAMIC_CALIBRATION_SUPPORT": "OFF",
        "DEPTHAI_ENABLE_LIBUSB": "ON",
        "DEPTHAI_ENABLE_APRIL_TAG": "OFF",
        "DEPTHAI_ENABLE_PROTOBUF": "OFF",
        "DEPTHAI_ENABLE_CURL": "OFF",
        "DEPTHAI_ENABLE_MP4V2": "OFF",
        "DEPTHAI_ENABLE_BACKWARD": "OFF",
        "DEPTHAI_ENABLE_DEVICE_FW": "OFF",
        "DEPTHAI_ENABLE_DEVICE_BOOTLOADER_FW": "ON",
        "DEPTHAI_ENABLE_DEVICE_RVC4_FW": "OFF",
        "DEPTHAI_BINARIES_RESOURCE_COMPILE": "ON",
        "DEPTHAI_GENERATE_HOUSING_COORDS": "OFF",
        "VCPKG_INSTALL_OPTIONS": "--clean-buildtrees-after-build;--clean-packages-after-build",
        "DEPTHAI_BUILD_DEVICE_MANAGER": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Developer build with tests, examples and Python bindings",
      "description": "RelWithDebInfo with a shared core library. With a static library, each of the about 300 test and example executables gets its own copy of the library debug info, and the build needs about 80 GB of disk.",
      "binaryDir": "${sourceDir}/build-dev",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_SHARED_LIBS": "ON",
        "DEPTHAI_BUILD_TESTS": "ON",
        "DEPTHAI_BUILD_EXAMPLES": "ON",
        "DEPTHAI_BUILD_PYTHON": "ON"
      }
    },
    {
      "name": "dev-rvc4-fw",
      "displayName": "Developer build with the RVC4 firmware from device/rvc4 (accepts the Luxonis DepthAI Vendor Module EULA)",
      "description": "RelWithDebInfo with a shared core library, tests, examples (also as tests) and Python bindings with docstrings and tests. Each configure step and each build also configure and build the RVC4 firmware from device/rvc4 in its build container (Docker). With this preset you accept the Luxonis DepthAI Vendor Module End User License Agreement of the prebuilt vendor archive (DEPTHAI_ACCEPT_VENDOR_EULA=yes): read it first (device/rvc4/README.md, Building).",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_SHARED_LIBS": "ON",
        "DEPTHAI_BUILD_TESTS": "ON",
        "DEPTHAI_BUILD_EXAMPLES": "ON",
        "DEPTHAI_TEST_EXAMPLES": "ON",
        "DEPTHAI_BUILD_PYTHON": "ON",
        "DEPTHAI_PYTHON_FORCE_DOCSTRINGS": "ON",
        "DEPTHAI_PYTHON_ENABLE_TESTS": "ON",
        "DEPTHAI_DEVICE_RVC4_VERSION": "",
        "DEPTHAI_DEVICE_RVC4_FWP_CONFIGURE": "ON",
        "DEPTHAI_ACCEPT_VENDOR_EULA": "yes"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "minimal",
      "configurePreset": "minimal",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "device-manager",
      "configurePreset": "device-manager",
      "configuration": "Release",
      "targets": [
        "depthai-device-manager"
      ],
      "jobs": 4
    },
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "dev-rvc4-fw",
      "configurePreset": "dev-rvc4-fw"
    }
  ]
}
