include(CMakeFindDependencyMacro)

find_dependency(nlohmann_json CONFIG REQUIRED)
find_dependency(libnop CONFIG REQUIRED)
find_dependency(XLink CONFIG REQUIRED COMPONENTS XLinkPublic)

set(DEPTHAI_OPENCV_SUPPORT @DEPTHAI_OPENCV_SUPPORT@)
set(DEPTHAI_PCL_SUPPORT @DEPTHAI_PCL_SUPPORT@)
set(DEPTHAI_XTENSOR_SUPPORT @DEPTHAI_XTENSOR_SUPPORT@)
set(DEPTHAI_DYNAMIC_CALIBRATION_SUPPORT @DEPTHAI_DYNAMIC_CALIBRATION_SUPPORT@)
set(DEPTHAI_DYNAMIC_CALIBRATION_STATIC @DEPTHAI_DYNAMIC_CALIBRATION_STATIC@)
set(DEPTHAI_BUILD_BETA @DEPTHAI_BUILD_BETA@)

if(DEPTHAI_OPENCV_SUPPORT)
    find_dependency(OpenCV 4 CONFIG REQUIRED)
endif()

if(DEPTHAI_PCL_SUPPORT)
    find_dependency(PCL CONFIG REQUIRED)
endif()

if(DEPTHAI_XTENSOR_SUPPORT)
    find_dependency(xtensor CONFIG REQUIRED)
endif()

# Resolve the private link dependencies exposed by every static core, using
# the same dependency declarations as the source build. Keep build-option
# values local so importing DepthAI does not change the consumer's options.
if(NOT "@BUILD_SHARED_LIBS@")
    function(_depthai_find_static_dependencies)
        set(CONFIG_MODE TRUE)
        set(DEPTHAI_SHARED_LIBS "@BUILD_SHARED_LIBS@")
        set(_IMPORT_PREFIX "@DEPTHAI_CONFIG_IMPORT_PREFIX@")
@DEPTHAI_CONFIG_STATIC_FEATURES@
        set(XLINK_LIBUSB_SYSTEM "@XLINK_LIBUSB_SYSTEM@")
        set(DEPTHAI_DYNAMIC_CALIBRATION_INSTALLED_LIBRARY "@DEPTHAI_DCL_CONFIG_LIBRARY@")
        set(DEPTHAI_DYNAMIC_CALIBRATION_INSTALLED_INCLUDE "@DEPTHAI_DCL_CONFIG_INCLUDE@")
        set(DEPTHAI_DYNAMIC_CALIBRATION_INSTALLED_ROOT "@DEPTHAI_DCL_CONFIG_ROOT@")
        include("${CMAKE_CURRENT_LIST_DIR}/depthaiDependencies.cmake")
    endfunction()
    _depthai_find_static_dependencies()
endif()

# Add the targets file
include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_EXPORT_GROUP@.cmake")

# Cleanup
set(_IMPORT_PREFIX)
