diff --git a/libusb/os/windows_winusb.c b/libusb/os/windows_winusb.c
index f603126f..505a80dd 100644
--- a/libusb/os/windows_winusb.c
+++ b/libusb/os/windows_winusb.c
@@ -86,6 +86,30 @@ static int composite_reset_device(int sub_api, struct libusb_device_handle *dev_
 static enum libusb_transfer_status composite_copy_transfer_data(int sub_api, struct usbi_transfer *itransfer, DWORD length);
 
 static usbi_mutex_t autoclaim_lock;
+static usbi_mutex_t interface_state_lock;
+static usbi_mutex_static_t winusb_lock_guard = USBI_MUTEX_INITIALIZER;
+static unsigned int winusb_lock_refcount;
+
+static void winusb_global_locks_init(void)
+{
+	usbi_mutex_static_lock(&winusb_lock_guard);
+	if (winusb_lock_refcount++ == 0) {
+		usbi_mutex_init(&autoclaim_lock);
+		usbi_mutex_init(&interface_state_lock);
+	}
+	usbi_mutex_static_unlock(&winusb_lock_guard);
+}
+
+static void winusb_global_locks_exit(void)
+{
+	usbi_mutex_static_lock(&winusb_lock_guard);
+	assert(winusb_lock_refcount != 0);
+	if (--winusb_lock_refcount == 0) {
+		usbi_mutex_destroy(&autoclaim_lock);
+		usbi_mutex_destroy(&interface_state_lock);
+	}
+	usbi_mutex_static_unlock(&winusb_lock_guard);
+}
 
 // API globals
 static struct winusb_interface WinUSBX[SUB_API_MAX];
@@ -513,6 +537,12 @@ static HANDLE windows_open(struct libusb_device_handle *dev_handle, const char *
 /*
  * Populate the endpoints addresses of the device_priv interface helper structs
  */
+static void windows_invalidate_endpoints(struct winusb_device_priv *priv, uint8_t iface)
+{
+	safe_free(priv->usb_interface[iface].endpoint);
+	priv->usb_interface[iface].nb_endpoints = 0;
+}
+
 static int windows_assign_endpoints(struct libusb_device_handle *dev_handle, uint8_t iface, uint8_t altsetting)
 {
 	struct winusb_device_priv *priv = usbi_get_device_priv(dev_handle->dev);
@@ -532,7 +562,7 @@ static int windows_assign_endpoints(struct libusb_device_handle *dev_handle, uin
 		goto end;
 	}
 	if_desc = &conf_desc->interface[iface].altsetting[altsetting];
-	safe_free(priv->usb_interface[iface].endpoint);
+	windows_invalidate_endpoints(priv, iface);
 
 	if (if_desc->bNumEndpoints == 0) {
 		usbi_dbg(HANDLE_CTX(dev_handle), "no endpoints found for interface %u", iface);
@@ -549,10 +579,6 @@ static int windows_assign_endpoints(struct libusb_device_handle *dev_handle, uin
 		}
 	}
 
-	// Extra init may be required to configure endpoints
-	if (priv->apib->configure_endpoints)
-		r = priv->apib->configure_endpoints(SUB_API_NOTSET, dev_handle, iface);
-
 	if (r == LIBUSB_SUCCESS)
 		priv->usb_interface[iface].current_altsetting = altsetting;
 
@@ -683,8 +709,8 @@ static int winusb_init(struct libusb_context *ctx)
 				usb_api_backend[i].designation);
 	}
 
-	// We need a lock for proper auto-release
-	usbi_mutex_init(&autoclaim_lock);
+	// These locks protect backend-global state and must outlive any one context.
+	winusb_global_locks_init();
 
 	return LIBUSB_SUCCESS;
 }
@@ -698,7 +724,7 @@ static void winusb_exit(struct libusb_context *ctx)
 
 	UNUSED(ctx);
 
-	usbi_mutex_destroy(&autoclaim_lock);
+	winusb_global_locks_exit();
 
 	for (i = 0; i < USB_API_MAX; i++) {
 		if (usb_api_backend[i].exit)
@@ -2012,13 +2038,20 @@ static int winusb_claim_interface(struct libusb_device_handle *dev_handle, uint8
 
 	CHECK_SUPPORTED_API(priv->apib, claim_interface);
 
-	safe_free(priv->usb_interface[iface].endpoint);
-	priv->usb_interface[iface].nb_endpoints = 0;
+	usbi_mutex_lock(&interface_state_lock);
+	windows_invalidate_endpoints(priv, iface);
+	usbi_mutex_unlock(&interface_state_lock);
 
 	r = priv->apib->claim_interface(SUB_API_NOTSET, dev_handle, iface);
 
-	if (r == LIBUSB_SUCCESS)
+	if (r == LIBUSB_SUCCESS) {
+		usbi_mutex_lock(&interface_state_lock);
+		priv->usb_interface[iface].current_altsetting = 0;
 		r = windows_assign_endpoints(dev_handle, iface, 0);
+		if (r == LIBUSB_SUCCESS && priv->apib->configure_endpoints)
+			r = priv->apib->configure_endpoints(SUB_API_NOTSET, dev_handle, iface);
+		usbi_mutex_unlock(&interface_state_lock);
+	}
 
 	return r;
 }
@@ -2030,13 +2063,20 @@ static int winusb_set_interface_altsetting(struct libusb_device_handle *dev_hand
 
 	CHECK_SUPPORTED_API(priv->apib, set_interface_altsetting);
 
-	safe_free(priv->usb_interface[iface].endpoint);
-	priv->usb_interface[iface].nb_endpoints = 0;
+	usbi_mutex_lock(&interface_state_lock);
+	windows_invalidate_endpoints(priv, iface);
+	usbi_mutex_unlock(&interface_state_lock);
 
 	r = priv->apib->set_interface_altsetting(SUB_API_NOTSET, dev_handle, iface, altsetting);
 
-	if (r == LIBUSB_SUCCESS)
+	if (r == LIBUSB_SUCCESS) {
+		usbi_mutex_lock(&interface_state_lock);
+		priv->usb_interface[iface].current_altsetting = altsetting;
 		r = windows_assign_endpoints(dev_handle, iface, altsetting);
+		if (r == LIBUSB_SUCCESS && priv->apib->configure_endpoints)
+			r = priv->apib->configure_endpoints(SUB_API_NOTSET, dev_handle, iface);
+		usbi_mutex_unlock(&interface_state_lock);
+	}
 
 	return r;
 }
