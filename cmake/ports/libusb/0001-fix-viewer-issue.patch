+static void winusb_global_locks_init(void)
+{
+	usbi_mutex_static_lock(&winusb_lock_guard);
+	if (winusb_lock_refcount++ == 0) {
+		usbi_mutex_init(&autoclaim_lock);
+		usbi_mutex_init(&interface_state_lock);
+	}
+	usbi_mutex_static_unlock(&winusb_lock_guard);
+}
+
+static void winusb_global_locks_exit(void)
+{
+	usbi_mutex_static_lock(&winusb_lock_guard);
+	assert(winusb_lock_refcount != 0);
+	if (--winusb_lock_refcount == 0) {
+		usbi_mutex_destroy(&autoclaim_lock);
+		usbi_mutex_destroy(&interface_state_lock);
+	}
+	usbi_mutex_static_unlock(&winusb_lock_guard);
