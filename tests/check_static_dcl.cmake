if(DCL_MACHO)
    set(inspect_options -L)
else()
    set(inspect_options -d)
endif()
execute_process(COMMAND "${INSPECTOR}" ${inspect_options} "${BINARY}"
    RESULT_VARIABLE result OUTPUT_VARIABLE dynamic ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Binary inspection failed: ${error}")
endif()
if(dynamic MATCHES "libdynamic_calibration[^\n]*(\\.so|\\.dylib)")
    message(FATAL_ERROR "Unexpected shared Dynamic Calibration dependency: ${dynamic}")
endif()
message(STATUS "No shared Dynamic Calibration dependency")
